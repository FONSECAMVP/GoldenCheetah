#ifndef _GC_Secrets_h
#define _GC_Secrets_h

/*
 * API Keys for LLM Providers
 * 
 * IMPORTANT: This file contains sensitive API keys and should NEVER be committed to version control.
 * 
 * Instructions:
 * 1. Copy this file to "Secrets.h" (without .template extension)
 * 2. Add "Secrets.h" to your .gitignore
 * 3. Replace the empty strings with your actual API keys
 * 4. Rebuild the project
 * 
 * To obtain API keys:
 * - OpenAI: https://platform.openai.com/api-keys
 * - Anthropic: https://console.anthropic.com/settings/keys
 * - Google Gemini: https://makersuite.google.com/app/apikey
 * 
 * Note: You only need to configure the providers you plan to use.
 */

// OpenAI API Key (for GPT-4o, GPT-4, GPT-3.5-turbo)
#define GCOpenAIAPIKey ""

// Anthropic API Key (for Claude models)
#define GCAnthropicAPIKey ""

// Google Gemini API Key (for Gemini models)
#define GCGeminiAPIKey ""

/*
 * Alternative: Environment Variables
 * 
 * Instead of hardcoding keys here, you can set environment variables:
 * - OPENAI_API_KEY
 * - ANTHROPIC_API_KEY
 * - GEMINI_API_KEY
 * 
 * The application will check environment variables if the defines above are empty.
 */

#endif // _GC_Secrets_h
